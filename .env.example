# --- OpenAI -----------------------------------------------------------------
# Used for embeddings (text-embedding-3-small) and fact extraction (gpt-4o-mini).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EXTRACT_MODEL=gpt-4o-mini
OPENAI_RPM_LIMIT=500

# --- Postgres (local docker-compose) ----------------------------------------
# Already wired to the docker-compose service. Don't change unless you know why.
POSTGRES_DSN=postgresql://brain:brain@localhost:5433/company_brain

# --- Azure / Microsoft Entra ------------------------------------------------
# App registration backing the connectors. Tenant admin must grant consent on
# the Graph + Fabric + Foundry permissions listed in CLAUDE.md.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Optional — leave empty to use device-code flow for Work IQ.
AZURE_CLIENT_SECRET=

# --- Fabric IQ --------------------------------------------------------------
# Comma-separated workspace GUIDs (https://app.fabric.microsoft.com → admin).
FABRIC_WORKSPACE_IDS=
# Optional: limit number of sample rows pulled per table (default 50).
FABRIC_SAMPLE_ROWS=50

# --- Work IQ (Microsoft Graph / M365) ---------------------------------------
# How many days of mail / teams / calendar to backfill on first ingest.
WORK_IQ_DAYS_BACK=30
# Override the user — defaults to /me (the signed-in identity).
WORK_IQ_USER=me

# --- Foundry IQ (Azure AI Foundry) ------------------------------------------
# Comma-separated Foundry project IDs from https://ai.azure.com
FOUNDRY_PROJECT_IDS=
# Endpoint for your Foundry resource (https://<name>.services.ai.azure.com).
FOUNDRY_ENDPOINT=

# --- Optional alt stores (off by default) -----------------------------------
# Set MEMORY_STORE=supermemory or =mem0 to swap backends. Default is postgres.
MEMORY_STORE=postgres
SUPERMEMORY_API_KEY=
MEM0_BASE_URL=http://localhost:8000
